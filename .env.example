# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# Google Sign-In (client ID may be shared with the frontend)
JWT_SECRET=
REFRESH_TOKEN_KEY=
GOOGLE_CLIENT_ID=

# SMTP email delivery (server-side only; never put these credentials in frontend env)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# For Gmail, use a current Google App Password for this account.
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Baco360

# Frontend base URL used in notification and password-reset links
# Use http://localhost:5173 for local Vite development; set the deployed app URL in production.
FRONTEND_URL=http://localhost:5173