# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Gmail SMTP (use a Google App Password; keep credentials on the backend only)
SMTP_HOST=
SMTP_PORT=
SMTP_ENCRYPTION=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Frontend URL used in report notification links (set the deployed app URL in production)
FRONTEND_URL=http://localhost:5173